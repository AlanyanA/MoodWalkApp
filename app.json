{
  "expo": {
    "name": "MoodWalk",
    "slug": "moodwalk",
    "scheme": "moodwalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MoodWalk uses your location to suggest nearby walking routes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/moodwalk"
    },
    "web": {
      "output": "single"
    }
  }
}
